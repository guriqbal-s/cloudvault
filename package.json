{
  "name": "cloudvault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CloudVault - full-stack cloud file storage and management platform",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "setup:local": "node scripts/setup-local.js",
    "dev:local": "docker compose up -d --wait mysql && npm run dev",
    "db:local": "docker compose up mysql",
    "docker:up": "docker compose up --build -d api web",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api web",
    "prod:up": "docker compose -f compose.yaml -f compose.prod.yaml up --build -d",
    "prod:down": "docker compose -f compose.yaml -f compose.prod.yaml down",
    "prod:logs": "docker compose -f compose.yaml -f compose.prod.yaml logs -f api web caddy",
    "prod:config": "docker compose -f compose.yaml -f compose.prod.yaml config --quiet",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "db:check": "node prisma/scripts/db-check.js",
    "db:setup": "node prisma/scripts/db-setup.js",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:deploy": "npm run db:deploy -w backend",
    "db:seed": "node prisma/seed.js",
    "hash-password": "node scripts/hash-password.js",
    "db:reset": "npm run db:reset -w backend && node prisma/seed.js",
    "db:studio": "npm run db:studio -w backend",
    "test": "npm test -w backend",
    "start": "npm run start -w backend",
    "postinstall": "prisma generate --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "allowScripts": {
    "@prisma/client": true,
    "bcrypt": true,
    "prisma": true,
    "@prisma/engines": true,
    "esbuild": true
  }
}
