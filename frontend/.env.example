# Frontend environment (copy to frontend/.env if you need to override defaults).
# In development the Vite proxy forwards /api and /socket.io to the backend, so these
# normally stay unset and the app talks to the same origin.

# Base URL for REST calls (default: /api/v1)
# VITE_API_URL=/api/v1

# Socket.IO endpoint (default: same origin)
# VITE_SOCKET_URL=

# Where the dev proxy forwards to (read by vite.config.js)
# VITE_PROXY_TARGET=http://localhost:4000
