# =====================================================================
# CloudVault - backend environment
# Copy this file to ".env" in the repository root (cloudvault/.env).
# The backend, the Prisma scripts and the seed script all read this one file.
# NEVER commit the real .env.
# =====================================================================

# ---- Runtime ---------------------------------------------------------
NODE_ENV=development
PORT=4000
# Origin of the web app (used for CORS, email links and cookies)
CLIENT_URL=http://localhost:5173
# Set true when running behind a reverse proxy / load balancer (nginx, ALB) so client IPs
# and rate limiting use X-Forwarded-For
TRUST_PROXY=false
# error | warn | info | debug  (default: info; "error" when NODE_ENV=test)
# LOG_LEVEL=info

# ---- Database: AWS RDS for MySQL --------------------------------------
#   mysql://<USER>:<PASSWORD>@<ENDPOINT>:<PORT>/<DB_NAME>?<options>
# Endpoint and port are already set to the CloudVault RDS instance (eu-north-1, port 3306).
# Fill in YOUR_DB_USER and YOUR_DB_PASSWORD: RDS console > your instance > Configuration >
# "Master username", and the password set when the instance was created.
# Percent-encode special characters in the password (@ -> %40, # -> %23, : -> %3A):
#   node -e "console.log(encodeURIComponent(process.argv[1]))" "my p@ss"
# The RDS CA bundle lives at prisma/rds-ca.pem (Prisma resolves sslcert relative to prisma/).
# The "cloudvault" database is created by "npm run db:setup" if it does not exist.
# See docs/aws-rds-setup.md for setup and connection checks.
DATABASE_URL="mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@database-1.cryam8ioiwyg.eu-north-1.rds.amazonaws.com:3306/cloudvault?sslcert=rds-ca.pem&sslaccept=strict&connect_timeout=15&connection_limit=10"
# For the local Docker MySQL (npm run dev:local), keep exactly one DATABASE_URL line active.
# DATABASE_URL="mysql://root:cloudvault-local-root@127.0.0.1:3307/cloudvault"

# ---- Scaling (optional) ---------------------------------------------
# Set to run more than one API instance: rate limits, live notifications (Socket.IO) and
# background-job locks are then shared through Redis. Leave empty for a single instance.
# docker compose sets this automatically (redis://redis:6379).
# Managed Redis with TLS (e.g. AWS ElastiCache): rediss://:PASSWORD@HOST:6379
REDIS_URL=

# ---- Auth ------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_DAYS=30
# Set true when serving over HTTPS (required in production)
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
# true = users must verify their email before they can log in
REQUIRE_EMAIL_VERIFICATION=true
PASSWORD_RESET_MINUTES=60
EMAIL_VERIFICATION_HOURS=24

# ---- File storage ----------------------------------------------------
# cloudinary = uploaded files are stored privately in your Cloudinary account
# local      = uploaded files are stored on disk under STORAGE_ROOT
STORAGE_DRIVER=cloudinary
# Disk folder. With Cloudinary it only holds short-lived upload staging files (tmp/).
# Resolved relative to the repository root, not the process working directory
STORAGE_ROOT=./storage

# ---- Cloudinary (used when STORAGE_DRIVER=cloudinary) -----------------
# Cloudinary console > Settings (gear icon) > API Keys. Fill in the three values below,
# or set CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME instead.
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
# CLOUDINARY_URL=
# Every object is stored under this folder in the Media Library
CLOUDINARY_FOLDER=cloudvault

# Largest single upload. The Cloudinary Free plan caps raw files at 10 MB, so keep this
# at 10485760 on Free; paid plans allow more (100 MB = 104857600).
# 100 MB per file
MAX_UPLOAD_BYTES=104857600
# 5 GB default quota for new users
DEFAULT_QUOTA_BYTES=5368709120
# Warn the user when usage crosses this percentage of their quota
QUOTA_WARNING_PERCENT=80
# Comma-separated allow-list (extension check; MIME is validated as well)
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,jpg,jpeg,png,gif,mp4,zip,csv

# ---- Trash and background jobs ---------------------------------------
TRASH_RETENTION_DAYS=30
# Cron expressions (node-cron syntax)
TRASH_PURGE_CRON="0 3 * * *"
LINK_EXPIRY_CRON="*/30 * * * *"
STORAGE_SNAPSHOT_CRON="5 0 * * *"

# ---- Rate limiting ---------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---- Email (Nodemailer). Leave SMTP_HOST empty to log emails to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CloudVault <no-reply@cloudvault.local>"

# ---- Seed data -------------------------------------------------------
# Password given to every demo account created by "npm run db:seed"
# Quoted because an unquoted "#" starts a comment in .env files
SEED_DEFAULT_PASSWORD="CloudVault#2026"

# ---- Docker (docker compose up) ----------------------------------------
# Port the web app is published on, http://localhost:<WEB_PORT>
WEB_PORT=8080
