# =====================================================================
# CloudVault - backend environment
# Copy this file to ".env" in the repository root (cloudvault/.env).
# The backend, the Prisma scripts and the seed script all read this one file.
# NEVER commit the real .env.
# =====================================================================

# ---- Runtime ---------------------------------------------------------
NODE_ENV=development
PORT=4000
# Origin of the web app (used for CORS, email links and cookies)
CLIENT_URL=http://localhost:5173
# Set true when running behind a reverse proxy / load balancer (nginx, ALB) so client IPs
# and rate limiting use X-Forwarded-For
TRUST_PROXY=false
# error | warn | info | debug  (default: info; "error" when NODE_ENV=test)
# LOG_LEVEL=info

# ---- Database -------------------------------------------------------
# AWS RDS for MySQL. Fill in the endpoint, username, and percent-encoded password.
# The RDS CA bundle belongs at prisma/rds-ca.pem. Prisma resolves sslcert from prisma/.
# See docs/aws-rds-setup.md for setup and connection checks.
DATABASE_URL="mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_RDS_ENDPOINT:3306/cloudvault?sslcert=rds-ca.pem&sslaccept=strict&connect_timeout=15&connection_limit=10"
# For a local MySQL 8.4 instance, keep exactly one DATABASE_URL line active.
# DATABASE_URL="mysql://root:cloudvault-local-root@127.0.0.1:3307/cloudvault"

# ---- Auth ------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_DAYS=30
# Set true when serving over HTTPS (required in production)
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
# true = users must verify their email before they can log in
REQUIRE_EMAIL_VERIFICATION=true
PASSWORD_RESET_MINUTES=60
EMAIL_VERIFICATION_HOURS=24

# ---- File storage (local disk; later S3) -----------------------------
# local | s3   (s3 is wired in a later phase)
STORAGE_DRIVER=local
# Resolved relative to the repository root, not the process working directory
STORAGE_ROOT=./storage
# 100 MB per file
MAX_UPLOAD_BYTES=104857600
# 5 GB default quota for new users
DEFAULT_QUOTA_BYTES=5368709120
# Warn the user when usage crosses this percentage of their quota
QUOTA_WARNING_PERCENT=80
# Comma-separated allow-list (extension check; MIME is validated as well)
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,jpg,jpeg,png,gif,mp4,zip,csv

# ---- Trash and background jobs ---------------------------------------
TRASH_RETENTION_DAYS=30
# Cron expressions (node-cron syntax)
TRASH_PURGE_CRON="0 3 * * *"
LINK_EXPIRY_CRON="*/30 * * * *"
STORAGE_SNAPSHOT_CRON="5 0 * * *"

# ---- Rate limiting ---------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---- Email (Nodemailer). Leave SMTP_HOST empty to log emails to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CloudVault <no-reply@cloudvault.local>"

# ---- Seed data -------------------------------------------------------
# Password given to every demo account created by "npm run db:seed"
# Quoted because an unquoted "#" starts a comment in .env files
SEED_DEFAULT_PASSWORD="CloudVault#2026"

# ---- AWS (NOT used yet - reserved for the later integration phase) ----
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
