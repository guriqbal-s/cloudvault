{
  "name": "cloudvault-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "dotenv -e ../.env -- prisma generate --schema ../prisma/schema.prisma",
    "db:migrate": "dotenv -e ../.env -- prisma migrate dev --schema ../prisma/schema.prisma",
    "db:deploy": "dotenv -e ../.env -- prisma migrate deploy --schema ../prisma/schema.prisma",
    "db:reset": "dotenv -e ../.env -- prisma migrate reset --force --skip-seed --schema ../prisma/schema.prisma",
    "db:studio": "dotenv -e ../.env -- prisma studio --schema ../prisma/schema.prisma",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "multer": "^2.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4",
    "prisma": "^6.0.0"
  }
}
